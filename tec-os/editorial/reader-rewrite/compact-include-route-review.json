  "decision": {
    "supported_unchanged_source_atom_call_shape": null,
    "exact_hold": "ATOM 0.3.7 public project preparation accepts source INCLUDE only before the first ordinary assembler statement and assembles dependencies before their importer. These nine clients have BDOS EQU before ABI.INC and executable HWLIB after their bodies. No existing inspected public route preserves those source bytes and both include positions.",
    "first_rejection": "For a valid project root and entry path, inspectAtomSource closes headerOpen at BDOS equ $0005 and predicts SourcePreparationError category preprocessing, code include-outside-header at ABI.INC. This occurs before dependency loading/native assembly. Merely being before ORG is insufficient.",
    "independent_trailing_boundary": "The later HWLIB include is also outside the header. Even resolving the earlier ABI position would leave that unsupported include placement. Moving executable HWLIB to a header import changes dependency/emission order and is not an equivalent representation.",
    "production_route": "The accepted primary route remains on-card TAS with the actual client, ABI.INC and HWLIB.ASM on the current drive. This review does not execute or requalify it.",
    "proof_boundary": "This resolves the route question as a precise hold. No ATOM output, byte/symbol equivalence, workflow success or runtime acceptance is claimed. No adapter or product fix is supplied."
  },
  "route_assessments": [
    {
      "route": "Documented atom CLI or assembleAtomProject({root, entry, target})",
      "result": "held",
      "support": [
        "A3:69-106",
        "A7:20-39",
        "A8:49-59",
        "A10:198-227"
      ],
      "reason": "The CLI and high-level public API both use the fixed ATOM source profile. Neither exposes a textual-include expansion switch, ordered caller input list or alternative include mode."
    },
    {
      "route": "resolveAtomProject then assembleResolvedAtomProject",
      "result": "not_an_existing_trailing_include_route",
      "support": [
        "A4:74-78",
        "A6:5-6",
        "A6:44-50",
        "A11:288-329",
        "A13:255-286"
      ],
      "reason": "The documented preparation function has the same header restriction. The lower-level runner is a real exported API for already prepared ordered parts, with equal-length original/compiler byte arrays. It does not prepare raw INCLUDE placement. Supplying hand-masked, split or reordered parts would introduce a separate source-preparation adapter. Public runner availability does not establish that missing route."
    },
    {
      "route": "TEC-OS assembleProgram(source, {base:0x100})",
      "result": "held",
      "support": [
        "T1:10-20"
      ],
      "reason": "It resolves a source under the fixed TEC-OS root and calls assembleAtomProject directly. base controls materialization, not include preparation. It has no include expansion, source-reader override or exposed per-assembly execution limits. staging must also remain inside that root."
    },
    {
      "route": "TEC-OS makeSvc(source, {work, deps})",
      "result": "not_a_COM_route",
      "support": [
        "T2:83-104",
        "T2:107-134",
        "T3:33-47"
      ],
      "reason": "The existing service-specific writer copies trailing include text into a derived service input, rewrites an exact uppercase ORG, performs two-origin assembly and requires INIT/REMOVE before packing a 25-byte SVC header. That transformation is not an exported generic COM expander and does not make these lowercase-org COM clients service sources. Reusing it as a COM adapter is outside its contract."
    },
    {
      "route": "TEC-OS assembleAt / makePrl / onDisk",
      "result": "held",
      "support": [
        "T3:17-67"
      ],
      "reason": "At origin 0100h assembleAt delegates directly to assembleProgram. Other origins require the exact uppercase ORG and repoint include paths without expanding trailing code. onDisk resolves case-insensitive filenames for those wrappers, not inclusion position. PRL packaging does not add a COM include mode."
    },
    {
      "route": "ATOM.COM on CP/M",
      "result": "held_for_same_source_include_grammar",
      "support": [
        "A3:166-180",
        "A16:5-54",
        "A17:76-87"
      ],
      "reason": "The native preflight also closes INC_HEAD on ordinary source and rejects a later INCLUDE before opening it. Current-drive case-insensitive names do not remove the placement restriction."
    },
    {
      "route": "test/lib/fixtures.mjs program helper",
      "result": "excluded_not_a_public_reader_route",
      "support": [
        "T6:29-54",
        "T6:75-79"
      ],
      "reason": "It fixes the entry under test/programs, can return cached assembly and otherwise calls the same standalone wrapper. The module also eagerly builds GLCD_SVC at top level. It neither resolves this include boundary nor supplies ordinary-reader proof. It was read only, never imported."
    }
  ],
