include "PARSE.BSI"
include "TEXTIO.BSI"
include "FORMAT.BSI"

enum CommandError
    unknownCommand
    missingArgument
    badNumber
end

sub execute(text: string[]): u16 fails CommandError
    var command: string[8]
    var argument: string[16]
    var io: IoError
    var parse: ParseError
    var found: boolean

    found = word(text, 0, var command) handle io
        fail CommandError.unknownCommand
    end
    if not found or not equal(command, "double")
        fail CommandError.unknownCommand
    end

    found = word(text, 1, var argument) handle io
        fail CommandError.badNumber
    end
    if not found
        fail CommandError.missingArgument
    end

    var value: u16
    value = parseU16(argument) handle parse
        fail CommandError.badNumber
    end
    if value > 32767
        fail CommandError.badNumber
    end

    return value * 2
end

sub main() fails IoError
    var result: u16
    var problem: CommandError
    result = execute("double 123") handle problem
    end
    assert result = 246
    var report: string[32]
    try append(var report, "Result: ")
    try appendU16(var report, result)
    try append(var report, "\r\n")
    try writeText(console, report)

    result = execute("double nope") handle problem
        assert problem = CommandError.badNumber
        assert result = 246
        try writeText(console, "Invalid number\r\n")
    end
    assert problem = CommandError.badNumber
end
