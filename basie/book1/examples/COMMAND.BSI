include "PARSE.BSI"
include "TEXTIO.BSI"
include "FORMAT.BSI"

const unknownCommand = 48
const missingArgument = 49

sub execute(text: string[]): u16 fails
    var command: string[8]
    var argument: string[16]

    var found = try word(text, 0, var command)
    if not found or not equal(command, "double")
        fail unknownCommand
    end

    found = try word(text, 1, var argument)
    if not found
        fail missingArgument
    end

    var value = try parseU16(argument)
    if value > 32767
        fail badNumber
    end

    return value * 2
end

sub main() fails
    var result: u16 = try execute("double 123")
    assert result = 246
    var report: string[32]
    try append(var report, "Result: ")
    try appendU16(var report, result)
    try append(var report, "\r\n")
    try writeText(console, report)

    var code: u8
    result = execute("double nope") handle code
        assert code = badNumber
        assert result = 246
        try writeText(console, "Invalid number\r\n")
    end
    assert code = badNumber
end
