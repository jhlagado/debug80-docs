var sequence: u8 = 0
var observed: u16 = 0

sub mark(value: u8): u8
    sequence = sequence * 10 + value
    return value
end

sub choose(left: u8, right: u8): u8
    if left > right
        return left
    end
    return right
end

sub main()
    observed = u16(choose(mark(2), mark(7))) + u16(sequence)
    assert observed = 34
end
