var subtotal: u16 = 120
var postage: u16 = 15
var total: u16

sub amountDue(amount: u16, shipping: u16): u16
    var due: u16 = amount + shipping
    amount = 0
    return due
end

sub main()
    total = amountDue(subtotal, postage)
    assert total = 135
    assert subtotal = 120

    total = amountDue(200, postage)
    assert total = 215
end
