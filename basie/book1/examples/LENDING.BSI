type Job = record
    number: u16
end

pool HJob: Job[1]

sub inspectJob(item: Job): u16
    return item.number
end

sub incrementJob(var item: Job)
    item.number = item.number + 1
end

sub consumeJob(item: HJob): u16
    return item.number
end

sub main()
    var first = new HJob(7)
    var remembered: weak HJob = first
    assert remembered = first

    assert inspectJob(first) = 7
    incrementJob(var first)
    assert first.number = 8
    assert remembered.number = 8

    var result = consumeJob(move first)
    assert result = 8

    var replacement = new HJob(11)
    assert replacement.number = 11
    assert remembered <> replacement

    select remembered
    case some(found)
        result = found.number
    case none
        result = 99
    end
    assert result = 99
end
