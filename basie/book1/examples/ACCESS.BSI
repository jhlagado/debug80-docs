record Reading
    value: u16
    usable: boolean
end

var current: Reading = (12, true)

sub inspect(item: Reading): u16
    return item.value
end

sub update(var item: Reading, value: u16)
    item.value = value
end

sub main()
    var saved: Reading
    saved = current

    update(var current, 20)
    assert inspect(current) = 20
    assert saved.value = 12
end
