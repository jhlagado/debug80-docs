var observed: u16 = 0

sub firstPositive(value: i8): i8
    while value <= 0
        value = value + 1
    end
    return value
end

sub main()
    var index: i8

    for index = -3 to 3 step 2
        if index = -1
            continue
        elseif index = 3
            exit
        end
        observed = observed + 1
    end
    observed = observed + u16(firstPositive(-2))
    assert observed = 3
end
