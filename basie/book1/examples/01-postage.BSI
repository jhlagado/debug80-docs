include "FORMAT.BSI"
include "TEXTIO.BSI"

var subtotal: u16 = 120
var postage: u16 = 15
var total: u16 = 0

sub main() fails
    total = subtotal + postage
    subtotal = 200
    assert subtotal = 200
    assert total = 135

    var report: string[16]
    appendU16(report, total) else fail
    writeLine(console, report) else fail
end
