var direction: i8 = -1
var observed: u16 = 0

sub main()
    if direction > 0
        observed = 1
    elseif direction < 0
        observed = 2
    else
        observed = 3
    end

    select direction
    case -1
        observed = observed + 10
    case 0
        observed = observed + 20
    case else
        observed = observed + 30
    end
    assert observed = 12
end
