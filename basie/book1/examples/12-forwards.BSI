forward sub odd(value: u8): boolean

sub even(value: u8): boolean
    if value = 0
        return true
    end
    return odd(value - 1)
end

sub odd
    if value = 0
        return false
    end
    return even(value - 1)
end

var observed: u16 = 0

sub main()
    if odd(7)
        observed = 1
    end
    assert observed = 1
end
