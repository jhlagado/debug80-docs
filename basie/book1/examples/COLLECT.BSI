record Job
    number as u16
end

pool jobs as Job[3]

sub addJob(var place as jobs?, value as u16) as boolean
    var candidate = new? jobs(value)
    select move candidate
    case some(allocated)
        place = move allocated
        return true
    case none
        return false
    end
end

sub takeJob(var place as jobs?) as u16
    select move place
    case some(taken)
        return taken.number
    case none
        return 0
    end
end

sub main()
    var queue as jobs?[3]
    var extra as jobs?

    assert addJob(queue[0], 7)
    assert addJob(queue[1], 9)
    assert addJob(queue[2], 11)
    assert not addJob(extra, 13)

    var completed = takeJob(queue[0])
    assert completed = 7
    assert addJob(queue[0], 13)

    assert takeJob(queue[1]) = 9
    assert takeJob(queue[2]) = 11
    assert takeJob(queue[0]) = 13
    assert takeJob(queue[0]) = 0
end
