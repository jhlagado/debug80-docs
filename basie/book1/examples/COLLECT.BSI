type Job = record
    number: u16
end

pool HJob: Job[3]

sub addJob(var place: HJob?, value: u16): boolean
    select move new? HJob(value)
    case some(allocated)
        place = move allocated
        return true
    case none
        return false
    end
end

sub takeJob(var place: HJob?): u16
    select move place
    case some(taken)
        return taken.number
    case none
        return 0
    end
end

sub main()
    var queue: HJob?[3]
    var extra: HJob?

    assert addJob(var queue[0], 7)
    assert addJob(var queue[1], 9)
    assert addJob(var queue[2], 11)
    assert not addJob(var extra, 13)

    var completed = takeJob(var queue[0])
    assert completed = 7
    assert addJob(var queue[0], 13)

    assert takeJob(var queue[1]) = 9
    assert takeJob(var queue[2]) = 11
    assert takeJob(var queue[0]) = 13
    assert takeJob(var queue[0]) = 0
end
