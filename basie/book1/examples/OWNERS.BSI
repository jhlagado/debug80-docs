type Job = record
    number: u16
end

pool HJob: Job[2]

sub consume(job: HJob): u16
    return job.number
end

sub main()
    var first = new HJob(7)
    var second = new HJob(9)

    var answer = consume(move first)
    assert answer = 7

    var replacement = new HJob(11)
    assert replacement.number = 11
    assert second.number = 9
end
