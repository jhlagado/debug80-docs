record Job
    number as u16
end

pool jobs as Job[2]

sub consume(job as jobs) as u16
    return job.number
end

sub main()
    var first = new jobs(7)
    var second = new jobs(9)
    var answer = consume(move first)
    assert answer = 7
    var replacement = new jobs(11)
    assert replacement.number = 11
    assert second.number = 9
end
