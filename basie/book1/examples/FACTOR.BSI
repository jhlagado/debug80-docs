forward sub factorial(n: u8): u32

sub factorial
    if n < 2
        return 1
    end
    return u32(n) * factorial(n - 1)
end

sub product(n: u8): u32
    var result: u32 = 1
    var k: u8
    for k = 2 to n
        result = result * u32(k)
    end
    return result
end

sub main()
    assert product(0) = 1
    assert product(5) = 120
    assert product(12) = 479001600
    assert factorial(12) = product(12)
end
