sub main()
    var signed as i16 = -8
    assert signed shr 1 = -4

    var bits as u8 = 3
    assert bits shl 2 = 12

    var small as u8 = 255
    small = small + 1
    assert small = 0

    var a as u16 = 40000
    var b as i16 = -3
    assert i32(a) + b = 39997

    assert not (true xor false) = false
end
