include "FORMAT.BSI"

record Reading
    value: u16
    usable: boolean
end

const sampleCount = 4
var samples: Reading[sampleCount] = [(12, true), (18, true), (16, true), (14, true)]

sub total(values: Reading[]): u32
    var sum: u32 = 0
    var index: u16

    for index = 0 until values.length
        if values[index].usable
            sum = sum + u32(values[index].value)
        end
    end
    return sum
end

sub sort(var values: Reading[])
    var cursor: u16
    for cursor = 1 until values.length
        var saved = values[cursor]
        var at: u16 = cursor
        while at > 0 and values[at - 1].value > saved.value
            values[at] = values[at - 1]
            at = at - 1
        end
        values[at] = saved
    end
end

sub main() fails
    var sum = total(samples)
    assert sum = 60

    sort(samples)
    assert samples[0].value = 12 and samples[3].value = 18

    var mean: f32 = f32(sum) / f32(sampleCount)
    var report: string[32]
    try append(report, "Mean: ")
    try appendF32(report, mean, 1)
    try append(report, "\r\n")
    try writeText(console, report)
end
