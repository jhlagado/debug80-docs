include "FORMAT.BSI"

record Reading
    value as u16
    usable as boolean
end

const sampleCount = 4
var samples as Reading[sampleCount] = [(12, true), (18, true), (16, true), (14, true)]

sub total(values as Reading[]) as u32
    var sum as u32 = 0
    var index as u16
    for index = 0 until values.length
        if values[index].usable
            sum = sum + u32(values[index].value)
        end
    end
    return sum
end

sub sort(var values as Reading[])
    var cursor as u16
    for cursor = 1 until values.length
        var saved = values[cursor]
        var at as u16 = cursor
        while at > 0 and values[at - 1].value > saved.value
            values[at] = values[at - 1]
            at = at - 1
        end
        values[at] = saved
    end
end

sub main() fails
    var sum = total(samples)
    assert sum = 60
    sort(samples)
    assert samples[0].value = 12 and samples[3].value = 18
    var mean as f32 = f32(sum) / f32(sampleCount)
    var report as string[32]
    append(report, "Mean: ") else fail
    appendF32(report, mean, 1) else fail
    append(report, "\r\n") else fail
    writeText(console, report) else fail
end
