include "PARSE.BSI"
include "TEXTIO.BSI"
include "FORMAT.BSI"

const unknownCommand = 48
const missingArgument = 49
const queueFull = 50

record Job
    number: u16
end

pool jobs: Job[2]

sub execute(text: string[]): u16 fails
    var command: string[8]
    var argument: string[16]

    var found = try word(text, 0, var command)
    if not found or not equal(command, "double")
        fail unknownCommand
    end

    found = try word(text, 1, var argument)
    if not found
        fail missingArgument
    end

    var value = try parseU16(argument)
    if value > 32767
        fail badNumber
    end

    return value * 2
end

sub createJob(text: string[]): jobs fails
    var number = try execute(text)
    var candidate = new? jobs(number)
    select move candidate
    case some(allocated)
        return move allocated
    case none
        fail queueFull
    end
end

sub reportJob(item: Job) fails
    var report: string[32]
    try append(var report, "Result: ")
    try appendU16(var report, item.number)
    try append(var report, "\r\n")
    try writeText(console, report)
end

sub main() fails
    var first = try createJob("double 123")
    assert first.number = 246
    try reportJob(first)

    var code: u8
    first = createJob("double nope") handle code
        assert code = badNumber
        assert first.number = 246
        try writeText(console, "Invalid number\r\n")
    end

    var second = try createJob("double 3")
    second = createJob("double 7") handle code
        assert code = queueFull
        assert second.number = 6
        try writeText(console, "Queue full\r\n")
    end

    assert code = queueFull
end
