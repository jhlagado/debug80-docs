var numbers: u8[4] = [2, 4, 6, 8]
var message: string[12]
var observed: u16 = 0

sub sum(values: u8[]): u16
    var index: u16
    var total: u16 = 0

    for index = 0 until values.length
        total = total + u16(values[index])
    end
    return total
end

sub writeOK(var text: string[])
    text.length = 2
    text[0] = 'O'
    text[1] = 'K'
end

sub main()
    writeOK(var message)
    observed = sum(numbers) + u16(message.length)
    assert observed = 22
end
