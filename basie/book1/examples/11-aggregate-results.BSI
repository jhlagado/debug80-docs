record Pair
    left: u8
    right: u8
end

var first: Pair = (3, 4)
var second: Pair
var observed: u16 = 0

sub selected(useFirst: boolean): Pair
    if useFirst
        return first
    end
    return second
end

sub copyPair(source: Pair, var destination: Pair)
    destination = source
end

sub main()
    copyPair(selected(true), second)
    observed = u16(second.left) * 10 + u16(second.right)
    assert observed = 34
end
