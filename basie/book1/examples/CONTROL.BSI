type Job = record
    number: u16
end

pool HJob: Job[1]

var observed: u16

sub incrementJob(var item: Job)
    item.number = item.number + 1
end

sub main()
    if true
        var first = new HJob(7)
        var unavailable = new? HJob(9)
        select move unavailable
        case some(unexpected)
            observed = unexpected.number
        case none
            observed = 1
        end
        assert first.number = 7
    end

    assert observed = 1

    var spare = new? HJob(9)
    select spare
    case some(job)
        observed = job.number
    case none
        observed = 0
    end
    assert observed = 9

    select move spare
    case some(job)
        incrementJob(var job)
        spare = move job
    case none
    end

    select spare
    case some(job)
        observed = job.number
    case none
        observed = 0
    end
    assert observed = 10
end
