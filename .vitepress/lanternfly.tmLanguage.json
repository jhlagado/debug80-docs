{
  "name": "lanternfly",
  "scopeName": "source.lanternfly",
  "fileTypes": ["lafy"],
  "patterns": [
    { "include": "#comment" },
    { "include": "#string" },
    { "include": "#character" },
    { "include": "#number" },
    { "include": "#keyword" },
    { "include": "#operatorWord" },
    { "include": "#type" },
    { "include": "#constant" },
    { "include": "#builtin" }
  ],
  "repository": {
    "comment": {
      "match": "//.*$",
      "name": "comment.line.double-slash.lanternfly"
    },
    "string": {
      "match": "\"[^\"]*\"",
      "name": "string.quoted.double.lanternfly"
    },
    "character": {
      "match": "'(\\\\.|[^'\\\\])'",
      "name": "constant.character.lanternfly"
    },
    "number": {
      "match": "(\\$[0-9a-fA-F]+|%[01]+|\\b\\d+\\b)",
      "name": "constant.numeric.lanternfly"
    },
    "keyword": {
      "match": "\\b(if|then|else|select|case|for|to|until|while|each|in|step|exit|continue|return|end|var|const|sub|enum|range|record|alias|import|export|extern|asm|at|from|near|far|as|volatile)\\b",
      "name": "keyword.control.lanternfly"
    },
    "operatorWord": {
      "match": "\\b(and|or|xor|not|mod|shl|shr)\\b",
      "name": "keyword.operator.word.lanternfly"
    },
    "type": {
      "match": "\\b(u8|i8|u16|i16|u32|i32|boolean|string|address)\\b",
      "name": "storage.type.lanternfly"
    },
    "constant": {
      "match": "\\b(true|false)\\b",
      "name": "constant.language.lanternfly"
    },
    "builtin": {
      "match": "\\b(abs|sqrt|length|size|count|lower|upper|offset|clear|fill|append)\\b",
      "name": "support.function.lanternfly"
    }
  }
}
